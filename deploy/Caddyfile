# Replace tradewind.example.org with the real domain on the server.
tradewind.example.org {
    root * /var/www/tradewind
    encode zstd gzip
    file_server

    # Hashed asset names change on every build, so they can be cached forever.
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    # The page itself must always be revalidated, whether requested as / or /index.html,
    # so a new deploy is picked up and never points at deleted assets.
    @page path / /index.html
    header @page Cache-Control "no-cache"
}
